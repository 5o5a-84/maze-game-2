<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>متاهة القوى المتزنة وغير المتزنة</title>

<style>

body{
    font-family: Tahoma, Arial, sans-serif;
    background: linear-gradient(135deg,#e3f2fd,#ffffff);
    text-align:center;
    margin:0;
    padding:20px;
}

h1{
    color:#0d47a1;
}

.instructions{
    background:white;
    max-width:800px;
    margin:10px auto;
    padding:15px;
    border-radius:15px;
    box-shadow:0 0 10px rgba(0,0,0,0.1);
}

#maze{
    display:grid;
    grid-template-columns:repeat(5,100px);
    gap:10px;
    justify-content:center;
    margin-top:30px;
}

.cell{
    width:100px;
    height:100px;
    display:flex;
    justify-content:center;
    align-items:center;
    border-radius:15px;
    font-size:28px;
    font-weight:bold;
}

.wall{
    background:#616161;
}

.path{
    background:#b3e5fc;
    cursor:pointer;
    transition:0.3s;
}

.path:hover{
    transform:scale(1.05);
}

.start{
    background:#4caf50;
    color:white;
}

.finish{
    background:#ffd600;
}

.active{
    border:5px solid red;
}

#message{
    margin-top:20px;
    font-size:22px;
    font-weight:bold;
    color:#1565c0;
}

#score{
    margin-top:10px;
    font-size:18px;
}

.win{
    animation:flash 1s infinite;
}

@keyframes flash{
    50%{
        transform:scale(1.08);
    }
}

</style>
</head>
<body>

<h1>🌀 متاهة القوى المتزنة وغير المتزنة</h1>

<div class="instructions">
<p>
اسلك الطريق الصحيح للوصول إلى الكنز.
</p>
<p>
✅ الإجابة الصحيحة تسمح لك بالتقدم.
</p>
<p>
❌ الإجابة الخاطئة تعيدك للمحاولة.
</p>
</div>

<div id="maze">

<div id="start" class="cell start active">🚩</div>
<div class="cell wall"></div>
<div class="cell wall"></div>
<div class="cell wall"></div>
<div class="cell wall"></div>

<div id="q1" class="cell path">🚗</div>
<div id="q2" class="cell path">⚽</div>
<div class="cell wall"></div>
<div class="cell wall"></div>
<div class="cell wall"></div>

<div class="cell wall"></div>
<div id="q3" class="cell path">🪢</div>
<div id="q4" class="cell path">🛒</div>
<div class="cell wall"></div>
<div class="cell wall"></div>

<div class="cell wall"></div>
<div class="cell wall"></div>
<div id="finish" class="cell finish">🏆</div>
<div class="cell wall"></div>
<div class="cell wall"></div>

</div>

<div id="message">
ابدأ بالضغط على السيارة 🚗
</div>

<div id="score">
النقاط: <span id="points">0</span>
</div>

<script>

const questions = [
{
id:"q1",
question:"سيارة متوقفة في مكانها",
correct:"متزنة"
},
{
id:"q2",
question:"كرة تحركت بعد ركلها",
correct:"غير متزنة"
},
{
id:"q3",
question:"شخصان يسحبان حبلاً بقوتين متساويتين ومتعاكستين",
correct:"متزنة"
},
{
id:"q4",
question:"عربة تتسارع بعد دفعها",
correct:"غير متزنة"
}
];

let step = 0;
let points = 0;

questions.forEach((item,index)=>{

document.getElementById(item.id).addEventListener("click",()=>{

if(index !== step){
document.getElementById("message").innerHTML =
"⬅️ اتبع ترتيب المتاهة أولاً";
return;
}

let answer = prompt(
item.question +
"\n\nاكتب:\nمتزنة\nأو\nغير متزنة"
);

if(answer === null) return;

answer = answer.trim();

if(answer === item.correct){

points += 10;
document.getElementById("points").textContent = points;

document.getElementById(item.id)
.style.background="#81c784";

step++;

if(step === questions.length){

document.getElementById("finish")
.classList.add("win");

document.getElementById("message").innerHTML =
"🎉 ممتاز! وصلت إلى الكنز وحصلت على " +
points +
" نقطة";

}else{

document.getElementById("message").innerHTML =
"✅ إجابة صحيحة! تابع المتاهة";
}

}else{

document.getElementById("message").innerHTML =
"❌ إجابة خاطئة، حاول مرة أخرى";
}

});

});

</script>

</body>
</html>